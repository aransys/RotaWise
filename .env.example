# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://rotawise:rotawise@localhost:5432/rotawise?schema=public"

# Auth.js — generate a secret with: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable the Google button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Set to "true" to show the "Continue with Google" button on the login page
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# Email (SMTP). Leave SMTP_HOST blank to log emails to the console instead of
# sending them — handy for local dev. Works with any SMTP provider
# (Mailtrap, Resend, SendGrid, Gmail app password, etc.).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"           # "true" for port 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RotaWise <no-reply@rotawise.local>"

# Redis (optional) — enables multi-instance real-time notification push.
# Leave blank for single-instance/in-process delivery.
REDIS_URL=""
